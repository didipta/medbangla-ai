# ============================================================
# MedBangla AI — Backend Environment Configuration (.env)
# ============================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neon PostgreSQL Database Connection String
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
# Replace with your actual Neon production branch connection URL:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-flat-cell-64402236.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
SECRET_KEY=generate_a_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vision AI Dual-Engine Settings (Doctor Handwriting Transcription)
# Primary Engine: Groq Vision (llama-3.2-11b-vision-preview, free from console.groq.com)
GROQ_API_KEY=
# Fallback Engine: Google Gemini Vision (gemini-2.0-flash, free from aistudio.google.com)
GEMINI_API_KEY=

# Local LLM (Optional)
OLLAMA_BASE_URL=http://localhost:11434
