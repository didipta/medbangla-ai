# =============================================================================
# MedBangla AI — Root Docker Compose Environment (.env)
# Copy this file to .env before running: docker compose up -d
# =============================================================================

# Port Bindings
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend Application Settings
ENVIRONMENT=production
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Neon PostgreSQL Database Connection String
# Example: postgresql://[user]:[password]@[neon-host]/neondb?sslmode=require
DATABASE_URL=

# AI & LLM Providers (At least one recommended for vision/RAG enhancements)
GROQ_API_KEY=
GEMINI_API_KEY=

# Security & Authentication
SECRET_KEY=medbangla_super_secret_jwt_key_please_change_this_in_production
GOOGLE_CLIENT_ID=340889956556-3286me1r8lfmiojisv7g2tre4n8h7bgg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Frontend Build & Runtime Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=340889956556-3286me1r8lfmiojisv7g2tre4n8h7bgg.apps.googleusercontent.com
