# ==========================================
# MedBangla AI - Root .gitignore
# ==========================================

# Operating System Files
# ----------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
# ------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Environment & Secret Variables
# ------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Logs & Debugging
# ----------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Frontend (Next.js / Node.js / TypeScript)
# ==========================================
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
.next/
out/
build/
dist/
.vercel

# TypeScript & Testing
*.tsbuildinfo
next-env.d.ts
coverage/

# ==========================================
# Backend (Python / Data Scraping & ML)
# ==========================================
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Unit test / coverage reports
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Type checking / Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter Notebooks & Scratch
.ipynb_checkpoints/
scratch/

# Local databases
*.sqlite
*.sqlite3
*.db

# Project Planning & Roadmap Documents
PROJECT_PLAN.md
STEP_BY_STEP_IMPLEMENTATION.md
*PLAN*.md
*plan*.md

